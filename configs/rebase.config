#
# JCG Q30 Pro 固件配置 — rebase 源码
# 源码: chasey-dev/immortalwrt-mt798x-rebase (25.12 分支)
# 工作流: .github/workflows/build-openwrt.yml (source_id=rebase)
#
# diffconfig 风格最小种子配置。使用: cp configs/rebase.config .config && make defconfig
# 依赖包（acme-*、kmod-wireguard、kmod-mediatek_hnat、mtwifi-cfg-ucode、
# kvcedit、ucode-mod-* 等）由 defconfig 自动补齐，无需手写，
# 参见 build/rebase-config.buildinfo。
#
# 说明（对比 2026-09-26 构建 build/rebase-config.buildinfo）：
# - luci / luci-app-firewall / luci-app-package-manager 在本源码中默认启用，
#   无需显式设置（如上游默认变更，scripts/verify-config.sh 会拦截缺失）。
# - eqos-mtk / mtwifi-cfg / turboacc-mtk 为 MTK 专有应用，本源码默认未启用，
#   必须显式声明。
#

# ============================================================
# 目标设备
# ============================================================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_jcg_q30-pro=y
# mt798x 分支当前默认即为 160，显式保留以防上游变更导致分区不匹配
CONFIG_TARGET_ROOTFS_PARTSIZE=160

# ============================================================
# LuCI 基础
# ============================================================
# LuCI 基础界面中文翻译（ImmortalWrt 默认未启用，显式开启中文界面）
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-theme-argon=y

# ---- 核心应用 ----
CONFIG_PACKAGE_pbr=y
CONFIG_PACKAGE_luci-app-pbr=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-app-acme=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-msd_lite=y
CONFIG_PACKAGE_luci-app-upnp=y

# ---- MTK 专有应用（硬件加速 / 无线配置 / 限速）----
CONFIG_PACKAGE_luci-app-turboacc-mtk=y
CONFIG_PACKAGE_luci-app-eqos-mtk=y
CONFIG_PACKAGE_luci-app-mtwifi-cfg=y

# ---- 中文翻译（zh-cn）----
CONFIG_PACKAGE_luci-i18n-pbr-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-acme-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_luci-i18n-msd_lite-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-turboacc-mtk-zh-cn=y
CONFIG_PACKAGE_luci-i18n-eqos-mtk-zh-cn=y
CONFIG_PACKAGE_luci-i18n-mtwifi-cfg-zh-cn=y

# ============================================================
# 显式禁用
# ============================================================
# ---- ttyd / passwall（三个源码统一禁用，网页终端与代理界面不在固件内）----
# CONFIG_PACKAGE_luci-app-ttyd is not set
# CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn is not set
# CONFIG_PACKAGE_luci-app-passwall is not set
