#
# JCG Q30 Pro 固件配置 — lede 源码
# 源码: coolsnowwolf/lede (master 分支)
# 工作流: .github/workflows/build-openwrt.yml (source_id=lede)
#
# diffconfig 风格最小种子配置。使用: cp configs/lede.config .config && make defconfig
# 依赖包（acme、kmod-wireguard、kmod-crypto-*、ttyd、wireguard-tools 等）
# 由 defconfig 自动补齐，无需手写，参见 build/lede-config.buildinfo。
#
# 说明（对比 2026-09-26 构建 build/lede-config.buildinfo）：
# - luci / luci-app-firewall / luci-app-package-manager 在 lede 中默认启用，
#   无需显式设置（如上游默认变更，scripts/verify-config.sh 会拦截缺失）。
# - ddns / wol / upnp / turboacc 当前亦为 lede 默认启用，此处仍显式声明，
#   因为它们属于本固件的核心功能清单（verify-config.sh 必需项）。
#

# ============================================================
# 目标设备
# ============================================================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_jcg_q30-pro=y
# lede 默认 ROOTFS_PARTSIZE 较小，需显式加大分区
CONFIG_TARGET_ROOTFS_PARTSIZE=160

# ============================================================
# LuCI 基础
# ============================================================
# LuCI 基础界面中文翻译（lede 默认未随 app 翻译一起拉入，显式启用）
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-theme-argon=y

# ---- 核心应用 ----
CONFIG_PACKAGE_pbr=y
CONFIG_PACKAGE_luci-app-pbr=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-app-acme=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-msd_lite=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-turboacc=y

# ---- 中文翻译（zh-cn）----
CONFIG_PACKAGE_luci-i18n-pbr-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-acme-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_luci-i18n-msd_lite-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y

# ============================================================
# 显式禁用
# ============================================================
# ---- ttyd / passwall（三个源码统一禁用，网页终端与代理界面不在固件内）----
# CONFIG_PACKAGE_luci-app-ttyd is not set
# CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn is not set
# CONFIG_PACKAGE_luci-app-passwall is not set
